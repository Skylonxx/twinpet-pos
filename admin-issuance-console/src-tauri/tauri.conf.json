{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Twinpet Issuer Console",
  "version": "1.0.0",
  "identifier": "com.twinpet.issuerconsole",
  "mainBinaryName": "TwinpetIssuerConsole",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Twinpet Issuer Console",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://asia-southeast1-twinpet-pos.cloudfunctions.net; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
