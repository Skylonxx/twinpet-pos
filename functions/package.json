{
  "name": "twinpet-pos-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node ../scripts/gen-deploy-config.mjs && tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions:verifyPinLogin,functions:reconcileOrder,functions:retryReconcile,functions:resolveTransferDiscrepancy,functions:resolveReversal,functions:shiftCloseEvidenceCapture,functions:shiftCloseValidationSweep,functions:shiftCloseSourceEventAsyncOrders,functions:shiftCloseSourceEventOrders,functions:shiftCloseSourceEventCashTransactions,functions:shiftCloseSourceEventCreditPayments,functions:resolveShiftCloseAlert,functions:getShiftCloseCaseFigures,functions:getOrderReceipt,functions:requestManagerApproval,functions:setUserAccount,functions:registerIssuer,functions:revokeIssuerRegistration,functions:beginDeviceEnrollmentAuthorizationIssuance,functions:completeDeviceEnrollmentAuthorizationIssuance,functions:beginDeviceRegistration,functions:completeDeviceRegistration,functions:beginPrivilegedOacIssuanceSession,functions:completePrivilegedOacIssuanceSession,functions:getOacKeysetManifest,functions:setRolePermissions,functions:roleSweepScheduler",
    "seed-admin": "npm run build && node lib/scripts/seed-admin.js",
    "seed-branch": "npm run build && node lib/scripts/seed-branch.js",
    "backfill-product-stocks": "npm run build && node lib/scripts/backfill-product-stocks.js",
    "repair-orphaned-orders": "npm run build && node lib/scripts/repair-orphaned-orders.js",
    "fix-invoker": "npm run build && node lib/scripts/fix-invoker.js",
    "census-usernames": "npm run build && node lib/scripts/censusUsernames.js",
    "repair-username-reservations": "npm run build && node lib/scripts/repairUsernameReservations.js",
    "migrate-username-reservations": "npm run build && node lib/scripts/migrateUsernameReservations.js",
    "verify-username-reservation-completeness": "npm run build && node lib/scripts/verifyUsernameReservationCompleteness.js",
    "set-username-migration-maintenance-mode": "npm run build && node lib/scripts/setUsernameMigrationMaintenanceMode.js",
    "migrate-credentials": "npm run build && node lib/scripts/migrateCredentials.js",
    "recover-user-credential": "npm run build && node lib/scripts/recoverUserCredential.js",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^9.15.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.7"
  }
}
